SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_JWT_SECRET=your_jwt_secret_here

# Stripe (backend secret keys)
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here

# Daily.co
DAILY_API_KEY=your_daily_api_key_here

# Supabase service role (required for: payments/payouts; "sitter requested to end" alert to parent)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Demo: skip real Stripe charge when parent ends session (for testing without payment method)
# DEMO_SKIP_PAYMENT_ON_END=1

# Currency: if amounts in DB are in LKR, set CURRENCY_IS_LKR=1 and LKR_TO_USD_RATE (Stripe charges in USD)
# CURRENCY_IS_LKR=1
# LKR_TO_USD_RATE=320
PLATFORM_FEE_PERCENT=15



# Stripe (backend secret keys)
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here

# Daily.co
DAILY_API_KEY=your_daily_api_key_here